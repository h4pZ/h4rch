{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "center",
  "cssPriority": "user",
  "control-center-width": 380,
  "control-center-height": 1280,
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 20,
  "control-center-margin-left": 0,
  "control-center-exclusive-zone": false,
  "notification-window-width": 400,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "label#pkgupdates",
    "label#vpnstatus",
    "label#nvda",
    "mpris",
    "title",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label#pkgupdates": {
      "text": "󰣇  Updates: 11 pacman · 0 AUR"
    },
    "label#vpnstatus": {
      "text": "󰐜  Disconnected"
    },
    "label#nvda": {
      "text": "󰻠 NVDA  $218.99   ▲ +11.99%\n▂▄▄▆▄▆▆▅▄▄▅▆▅▅▂▂▁▂▃▄▆█▇  1mo"
    },
    "mpris": {
      "image-size": 94,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "command": "amixer set Master toggle"
        },
        {
          "label": "",
          "command": "amixer set Capture toggle"
        },
        {
          "label": " ",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰏘",
          "command": "nwg-look"
        }
      ]
    }
  }
}
